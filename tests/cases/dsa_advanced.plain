use "dsa"

set seed to 12345
define next_random with limit
    set seed to (seed * 1103515245 + 12345) % 2147483648
    give back quotient(seed, 65536) % limit + 1
end

# ---- Trie: checked against filtering the word list
set words to ["apple", "app", "apricot", "banana", "band", "bandana", "ban", "cat", "car", "cart", "a"]
set t to new Trie()
for each w in words
    t's put(w)
end
t's put("app")
say t's size(), t's has("app"), t's has("appl"), t's starts_with("appl"), t's starts_with("x")
for each prefix in ["", "a", "ap", "app", "ban", "car", "c", "z", "bandana"]
    set expected to []
    for each w in sort(words)
        if starts_with(w, prefix) then
            add w to expected
        end
    end
    if t's words_with_prefix(prefix) is not expected then
        say "TRIE MISMATCH for", prefix
    end
end
say t's words_with_prefix("ban")

# ---- UnionFind
set friends to new UnionFind(8)
say friends's connect(1, 2), friends's connect(2, 3), friends's connect(1, 3), friends's connect(5, 6)
say friends's same_group(1, 3), friends's same_group(1, 5), friends's groups(), friends's size_of(2)
friends's connect(3, 6)
say friends's same_group(1, 5), friends's groups(), friends's size_of(5)
set many to new UnionFind(1000)
for i from 1 to 999
    many's connect(i, i + 1)
end
say many's groups(), many's size_of(500)

# ---- RingBuffer
set ring to new RingBuffer(3)
for each n in [1, 2, 3, 4, 5]
    ring's put_overwrite(n)
end
say ring's to_list(), ring's peek(), ring's is_full(), ring's size()
say ring's take(), ring's take(), ring's to_list()
ring's put(9)
ring's put(10)
say ring's to_list(), ring's is_full()
try
    ring's put(11)
on error problem
    say "full:", problem
end

# ---- Deque: 3000 random operations against a plain list kept in step
set d to new Deque()
set model to []
set mismatch to 0
for step from 1 to 3000
    set pick to next_random(4)
    if pick is 1 then
        d's push_back(step)
        add step to model
    otherwise if pick is 2 then
        d's push_front(step)
        insert(model, 1, step)
    otherwise if pick is 3 and length of model is greater than 0 then
        if d's pop_front() is not pop_at(model, 1) then
            increase mismatch by 1
        end
    otherwise if length of model is greater than 0 then
        if d's pop_back() is not pop(model) then
            increase mismatch by 1
        end
    end
    if d's size() is not length of model then
        increase mismatch by 1
    end
end
say "deque mismatches:", mismatch, d's to_list() is model, d's size()

# ---- LRUCache
set recent to new LRUCache(3)
recent's put("a", 1)
recent's put("b", 2)
recent's put("c", 3)
say recent's keys()
say recent's get_value("a"), recent's keys()
recent's put("d", 4)
say recent's has("b"), recent's keys(), recent's size()
recent's put("c", 30)
say recent's get_value("c"), recent's keys(), recent's get_value("nope")

# ---- FenwickTree and SegmentTree against plain sums
set size to 200
set fen to new FenwickTree(size)
set plain_numbers to []
repeat size times
    add 0 to plain_numbers
end
set seg_sum to new SegmentTree(plain_numbers, "sum")
set seg_min to new SegmentTree(range(1000, 1000 + size - 1), "min")
set base to range(1000, 1000 + size - 1)
set wrong to 0
for step from 1 to 600
    set i to next_random(size)
    set v to next_random(100)
    fen's add_at(i, v)
    set plain_numbers[i] to plain_numbers[i] + v
    seg_sum's update(i, plain_numbers[i])
    seg_min's update(i, v)
    set base[i] to v
    set a to next_random(size)
    set b to next_random(size)
    if a is greater than b then
        set held to a
        set a to b
        set b to held
    end
    set expected_sum to 0
    set expected_min to base[a]
    for k from a to b
        increase expected_sum by plain_numbers[k]
        set expected_min to min(expected_min, base[k])
    end
    if fen's range_sum(a, b) is not expected_sum or seg_sum's query(a, b) is not expected_sum or seg_min's query(a, b) is not expected_min then
        increase wrong by 1
    end
end
say "range mismatches:", wrong
say fen's prefix_sum(size) is sum(plain_numbers)
try
    fen's add_at(0, 1)
on error problem
    say problem
end
try
    new SegmentTree([1, 2], "product")
on error problem
    say problem
end

# ---- AVLTree: stays shallow even when values arrive in order
set sorted_input to new AVLTree()
for i from 1 to 1000
    sorted_input's put(i)
end
say sorted_input's size(), sorted_input's height(), sorted_input's is_balanced(), sorted_input's has(777), sorted_input's has(1001)
set shuffled to new AVLTree()
set unique_values to {}
repeat 800 times
    set v to next_random(5000)
    shuffled's put(v)
    set unique_values[v] to true
end
say shuffled's in_order() is sort(keys(unique_values)), shuffled's size() is length of keys(unique_values), shuffled's is_balanced(), shuffled's height() is at most 14
set small to new AVLTree()
for each v in [30, 20, 10]
    small's put(v)
end
say small's root's value, small's root's left's value, small's root's right's value, small's height()

# ---- Counter
set seen to new Counter()
for each word in split("the cat and the hat and the bat", " ")
    seen's put(word)
end
say seen's count_of("the"), seen's count_of("dog"), seen's total(), seen's distinct()
say seen's most_common(3)
