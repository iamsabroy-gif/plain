# a tour of what Plain 2.0 adds - big numbers, closures, classes and tasks

say "-- numbers"
say 2 ^ 100
say 0.1d + 0.2d, 0.1 + 0.2 is 0.3
say fixed(1234.5d * 1.18d, 2)

say "-- closures"
define make_counter
    set count to 0
    give back action
        increase count by 1
        give back count
    end
end
set next to make_counter()
say next(), next(), next()
say sort_by(["pear", "fig", "banana"], action with w gives length of w)

say "-- classes"
class Account
    init with owner, balance
        set me's owner to owner
        set me's balance to balance
    end
    define deposit with amount
        if amount is at most 0 then
            fail with "Deposit must be positive"
        end
        increase me's balance by amount
    end
    define to_text
        give back me's owner + ": " + fixed(me's balance, 2)
    end
end
class Savings extends Account
    define add_interest with percent
        me's deposit(me's balance * percent / 100d)
    end
end
set acct to new Savings("Asha", 1000d)
acct's add_interest(2.5d)
say acct

say "-- tasks"
set results to channel()
define square_later with n
    send(results, n * n)
end
set jobs to []
for i from 1 to 4
    add start_task(square_later, i) to jobs
end
for each job in jobs
    wait_for(job)
end
close_channel(results)
set total to 0
set msg to receive(results)
while msg is not nothing
    increase total by msg
    set msg to receive(results)
end
say "sum of squares:", total
